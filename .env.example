# ---------------------------------------------------------------------------
# SM Content Creator v2 - environment variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# On Railway, set these as project environment variables (not in the repo).
# ---------------------------------------------------------------------------

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (Railway Postgres) ---
# Railway injects DATABASE_URL automatically when a Postgres plugin is attached.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- AI providers ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Model identifiers (config, not hardcoded). Override when newer models ship.
CLAUDE_TEXT_MODEL=claude-sonnet-5
GEMINI_IMAGE_MODEL=gemini-3-pro-image
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Storage: Google Drive API ---
# Service-account JSON: either an absolute path to the file, or the raw JSON.
GOOGLE_DRIVE_CREDENTIALS_JSON=
# Drive folder ID where generated images land for human review.
GOOGLE_DRIVE_REVIEW_FOLDER_ID=

# --- Admin panel (basic auth) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Scheduling ---
TREND_SOURCES_CONFIG=config/trend_sources.yaml
